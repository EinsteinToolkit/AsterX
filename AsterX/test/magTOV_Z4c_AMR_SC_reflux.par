###############################
# Simple test of magnetised TOV neutron star
# Same neutron star as the gallery example
# K=100, rho_c = 1.28e-3 => M = 1.4, M_b = 1.506
# evolve for t = 48.82 M
#
# Same setup as magTOV_Z4c_AMR_SC_gauge_register (nodal gauge register on,
# CarpetX poisoning at its default), but with the driver's flux-register
# (reflux) correction of cons_vector on (CarpetX::do_reflux = yes).
# This test pins the correction on realistic physics: under subcycling the
# driver accumulates the stage-weighted hydro fluxes of both levels into a
# register and repays the coarse/fine mismatch to the coarse cells at the
# refinement boundary once per coarse step, before restriction. The masked
# totals of cons_vector (CarpetX::out_norm_vars) are not part of the reference
# data: the star's atmosphere flows out through the outer boundary, so they
# are not a conservation diagnostic here, and DEnt's first moment (sumloc)
# differs between arm64 and x86_64 builds by more than the test tolerance.
# Sound_wave_AMR_SC_reflux is the periodic test where they are constant to
# round-off. The interface B-shell guardrail (doc/documentation.tex) is read
# off this test.
##############################
ActiveThorns = "
    ADMBaseX
    BoxInBox
    CarpetX
    HydroBaseX
    IOUtil
    ODESolvers
    TmunuBaseX
    AsterX
    AsterSeeds
    Z4c
    AsterMasks
"

$nlevels	= 2
$ncells 	=  24

CarpetX::verbose = no
Cactus::presync_mode = "mixed-error"
# Detailed per-routine timers (incl. AsterX_Fluxes) via TimerReport, which
# dumps every flesh timer -- unlike Cactus::cctk_timer_output, whose
# schedule-bin view hides routines driven inside the ODESolvers RHS group.
# Reports are written to the test output dir (AllTimers*.txt/.csv/.tsv,
# AllTimersReadable.txt) and captured by the CI artifact.
ActiveThorns = "TimerReport"
TimerReport::out_every                   = 50
TimerReport::out_filename                = "TimerReport"
TimerReport::output_all_timers_together  = yes
TimerReport::output_all_timers_readable  = yes
TimerReport::n_top_timers                = 50
# CarpetX::poison_undefined_values is left at its default (yes) so the test
# also covers the register's startup path under full validity checking.

CarpetX::use_subcycling = yes
CarpetX::restrict_during_sync = no
# Nodal gauge register on (the default). magTOV_Z4c_AMR_SC_gauge_register
# runs the same setup with the reflux correction off (CarpetX::do_reflux = no,
# the default); the reflux correction is switched on here because this test
# exists to pin it.
AsterX::gauge_register = yes
CarpetX::do_reflux = yes

# Finest grid spacing is 0.15625 
# To have a symmetric grid along 0, we have odd number of points (257) 
# along each direction going from -20.078125 to +20.078125 for the finest level

CarpetX::xmin = -12
CarpetX::ymin = -12
CarpetX::zmin = -12

CarpetX::xmax = 12
CarpetX::ymax = 12
CarpetX::zmax = 12

CarpetX::ncells_x = $ncells
CarpetX::ncells_y = $ncells
CarpetX::ncells_z = $ncells

CarpetX::boundary_x =  "neumann"
CarpetX::boundary_y =  "neumann"
CarpetX::boundary_z =  "neumann"
CarpetX::boundary_upper_x =  "neumann"
CarpetX::boundary_upper_y =  "neumann"
CarpetX::boundary_upper_z =  "neumann"

CarpetX::max_num_levels = $nlevels
CarpetX::regrid_every = 128000
CarpetX::regrid_error_threshold = 0.9

CarpetX::ghost_size = 3
CarpetX::dtfac = 0.25

CarpetX::prolongation_type = "ddf" #"poly-cons3lfb"
#CarpetX::prolongation_order = 5
#CarpetX::interpolation_order = 1

CarpetX::blocking_factor_x = 1
CarpetX::blocking_factor_y = 1
CarpetX::blocking_factor_z = 1

BoxInBox::num_regions = 1
# Region 1
BoxInBox::shape_1 = "cube"
BoxInBox::num_levels_1 = $nlevels 
BoxInBox::radius_1 = [ -1.0, 3 ]


#ADMBaseX::set_adm_variables_during_evolution = "yes"
ADMBaseX::initial_data       = "tov"
ADMBaseX::initial_lapse      = "tov"
ADMBaseX::initial_shift      = "tov"
ADMBaseX::initial_dtlapse    = "zero"
ADMBaseX::initial_dtshift    = "zero"

Z4c::calc_ADM_vars = yes                  # for Weyl
Z4c::calc_ADMRHS_vars = no  #yes               # for Weyl
Z4c::calc_constraints = yes
Z4c::chi_floor = 1.0e-6
Z4c::alphaG_floor = 1.0e-8
Z4c::epsdiss = 0.32
Z4c::boundary_conditions = "NewRadX"

ActiveThorns = "TOVSolverX"
TOVSolverX::TOV_Rho_Central[0] = 1.28e-3
TOVSolverX::TOV_Gamma          = 2.0
TOVSolverX::TOV_K              = 100.0
TOVSolverX::TOV_Cowling = no


AsterSeeds::test_type = "3DTest"
AsterSeeds::test_case = "magTOV"
AsterSeeds::Afield_config = "internal dipole"
AsterSeeds::Ab = 100.0
AsterSeeds::press_cut = 0.04
AsterSeeds::press_max = 1.638e-4
AsterSeeds::Avec_kappa = 2.0
# With poisoning on, AsterSeeds::SetEntropy (HydroBaseX_PostInitial) writes
# NaN entropy at every point outside the star (kappa of the unfloored vacuum),
# and CarpetX's output check aborts the run there. AsterX_CheckPrims recomputes
# entropy everywhere from the floored primitives right afterwards, so skipping
# SetEntropy changes no evolved quantity (verified bit-identical). Unrelated to
# the gauge register.
AsterSeeds::set_entropy_postinitial = no

#AsterSeeds::Afield_config = "external dipole"
#AsterSeeds::B0 = 1e-7
#AsterSeeds::r0 = 5.0

AsterX::debug_mode = "no"
AsterX::flux_type = "HLLE"
AsterX::vector_potential_gauge = "generalized Lorenz"
AsterX::lorenz_damp_fac = 12.8571428571429
AsterX::local_spatial_order = 4
AsterX::local_estimate_error = "no"
AsterX::recon_type = "z_vec"
AsterX::use_entropy_fix = "yes"
AsterX::use_uct         = "yes"

ReconX::reconstruction_method = "PPM"
ReconX::ppm_zone_flattening = "yes"
ReconX::ppm_shock_detection = "no"

Con2PrimFactory::c2p_prime = "Noble"
Con2PrimFactory::c2p_second = "Palenzuela"
Con2PrimFactory::c2p_tol = 1e-8
Con2PrimFactory::max_iter = 100
Con2PrimFactory::rho_abs_min = 1e-11
Con2PrimFactory::atmo_tol = 1e-3
Con2PrimFactory::unit_test = "yes"
Con2PrimFactory::B_lim = 1e8
Con2PrimFactory::vw_lim = 1e8
Con2PrimFactory::Ye_lenient = "yes"
Con2PrimFactory::use_z = "yes"
Con2PrimFactory::thermal_eos_atmo = "no"

EOSX::evolution_eos = "IdealGas"
EOSX::gl_gamma = 2.0
EOSX::poly_gamma = 2.0
EOSX::poly_k = 100
EOSX::rho_max = 1e8
EOSX::eps_max = 1e8
EOSX::eps_min = 1e-9

Cactus::terminate = "iteration"
Cactus::cctk_itlast = 100
#Cactus::cctk_final_time = 200
ODESolvers::method = "RK4"

IO::out_dir = $parfile
IO::out_every = 50
IO::parfile_write = no

CarpetX::out_metadata = no
# No norm output: the masked reductions of cons_vector are not reproducible
# across platforms within the test tolerance (see the header).
CarpetX::out_norm_vars = " "
CarpetX::out_norm_omit_unstable = yes

CarpetX::out_tsv_vars = "
    HydroBaseX::rho
    HydroBaseX::vel
    HydroBaseX::eps
    HydroBaseX::press
    HydroBaseX::Bvec
    AsterX::Avec_x
    AsterX::Avec_y
    AsterX::Avec_z
    AsterX::cons_vector
    AsterX::dBx_stag
    AsterX::dBy_stag
    AsterX::dBz_stag
"
