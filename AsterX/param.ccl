# Parameter definitions for thorn AsterX

KEYWORD vector_potential_gauge "Gauge choice of four-vector potential A" STEERABLE=always
{
  "algebraic" :: ""
  "generalized Lorenz" :: ""
} "generalized Lorenz"

CCTK_REAL lorenz_damp_fac "Damping factor used in the Lorenz Gauge (see Farris et al 2012)" STEERABLE=always
{
 0:* :: "should be positive"
} 0.0

BOOLEAN use_uct "Shall we use the Upwind-CT method to compute the electric field (instead of the fluxCT approach)?" STEERABLE=always
{
} "no"

BOOLEAN use_entropy_fix "Shall we use inversion based on entropy as a backup?" STEERABLE=always
{
} "no"

BOOLEAN prolongate_dbstag "Shall we prolongate dBstag?" STEERABLE=always
{
} "no"

BOOLEAN restrict_fluxes "Restrict the hydro fluxes fine-to-coarse at every RHS stage before the coarse RHS uses them. Only scheduled without subcycling, where every level is at the same time inside ODESolvers_RHS; under subcycling nothing is restricted and the parameter has no effect. Under subcycling the conservative coupling of cons_vector across refinement boundaries is instead provided by the driver's flux register (CarpetX::do_reflux, off by default; set it to yes to enable), which cons_vector opts into through its fluxes= tag" STEERABLE=always
{
} "yes"

BOOLEAN restrict_aux_terms "Restrict the auxiliary gauge term G for the Avec RHS fine-to-coarse at every RHS stage before the coarse RHS uses it. The edge electric field E is not restricted: it only enters the Avec RHS on the fine-covered coarse edges themselves, which the driver's restriction of Avec overwrites. Only scheduled without subcycling, where every level is at the same time inside ODESolvers_RHS; under subcycling nothing is restricted and the parameter has no effect" STEERABLE=always
{
} "yes"

# Nodal gauge register (see src/gauge_register.cxx and doc/documentation.tex).
# Under subcycling the coarse and fine levels accumulate different time
# integrals of the gauge term G at the nodes they share, and the driver's
# restriction of Avec then leaves that mismatch as a spurious curl (a B shell)
# in the first coarse cell outside every refinement boundary. With
# gauge_register = yes AsterX evolves a vertex ledger IG with IG_rhs = G on
# every level and, in CarpetX's CarpetX_PreRestrict group, immediately before
# each time-aligned restriction, shifts the coarse Avec edges near each
# interface by the edge-difference of (IG_fine - IG_coarse) so both levels use
# one gauge integral per shared node; the driver's own restriction and halo
# refill then follow, so the register issues no Avec transfer itself. IG is
# re-zeroed on every full cascade. The register never enters the RHS and only
# changes Avec within one gauge-stencil width of a refinement boundary. It
# requires a CarpetX that provides the CarpetX_PreRestrict group; against one
# that does not, the group is never traversed and the register is inert.
# It is active only when all of the following hold: gauge_register = yes,
# vector_potential_gauge = "generalized Lorenz", and
# CarpetX::use_subcycling = yes. Otherwise IG_rhs = 0, no reconcile is
# scheduled, and the run is bit-identical to one without the register; without
# subcycling the mismatch is identically zero and the register is inert by
# design. On a subcycled run with a single refinement level no full cascade
# ever runs, so IG accumulates the integral of G over the whole run without
# being re-zeroed; this has no effect on Avec, since no reconcile runs either.
# Storage for IG, IG_rhs and IGr is always allocated (ODESolvers needs storage
# on every rhs-tagged group).
BOOLEAN gauge_register "Evolve the nodal gauge register IG (IG_rhs = G) and reconcile coarse Avec edges to the fine gauge integral before each time-aligned restriction. Only active in the generalized Lorenz gauge with CarpetX::use_subcycling = yes; otherwise the register is inert and the run is unchanged." STEERABLE=never
{
} "yes"

KEYWORD flux_type "Flux solver" STEERABLE=always
{
  "LxF" :: ""
  "HLLE" :: ""
} "LxF"

CCTK_INT hydro_correction_order "Order of accuracy for higher order corrections to hydrodynamic fluxes" STEERABLE=never
{
  2 :: "Second order accurate"
  4 :: "Fourth order accurate"
  6 :: "Sixth order accurate"
} 2

BOOLEAN use_pplim "Use positivity preserving limiter?" STEERABLE=always
{
} "no"

BOOLEAN use_deriv_shock_detector "Use shock detection measure (see Berta+ 2025, Kiuchi 2025)?" STEERABLE=always
{
} "no"

CCTK_REAL eta_thresh "Threshold for shock detection measure (see Berta+ 2025, Kiuchi 2025) " STEERABLE=always
{
  *:* :: "Large number (eg. 1e100) to force H.O., negative to force L.O."
} 0.005

CCTK_REAL loworder_rho_thresh "Set low-order flag to 0 below density threshold" STEERABLE=always
{
  0:* :: "Larger than zero"
} 0.0

BOOLEAN loworder_flux "Fall back to Lax-Friedrichs flux on flagged points?" STEERABLE=always
{
} "no"

BOOLEAN local_estimate_error "Use error estimation criteria of this thorn" STEERABLE=always
{
} yes

KEYWORD regrid_method "Regrid method" STEERABLE=always
{
  "first derivative" :: ""
  "second derivative" :: ""
  "second derivative norm" :: ""
  "first gradient" :: ""
} "first gradient"

CCTK_REAL epsilon_err "epsilon parameter in second derivative norm criterion (see Mignone+2011 eq. 50 arXiv:1110.0740)" STEERABLE=always
{
  0:* :: "Larger than zero, default from Mignone+2011"
} 0.01

CCTK_STRING regrid_groups "Groups used for calculating regrid error" STEERABLE=always
{
  .* :: "List of full group names"
} "HydroBaseX::rho"

BOOLEAN debug_mode "Print debug information if set to yes" STEERABLE=always
{
} no

BOOLEAN unit_test "turn on all the unit tests if set to yes" STEERABLE=always
{
} no

BOOLEAN freeze_evolution "Freeze AsterX evolution while retaining initialization and poststep primitive updates" STEERABLE=always
{
} no

CCTK_INT unit_test_repetitions "Number of times each unit test should be repeated" STEERABLE=always 
{
  0:* :: "Must be no smaller than 0"
} 1

restricted:

CCTK_INT mag_correction_order "Order of accuracy for higher order corrections to magnetic field evolution" STEERABLE=never
{
  2 :: "Second order accurate"
  4 :: "Fourth order accurate"
  6 :: "Sixth order accurate"
} 2

KEYWORD recon_type "Vector field used in reconstruction" STEERABLE=always
{
  "v_vec" :: "Eulerian 3-velocity"
  "z_vec" :: "Lorentz factor x Eulerian 3-velocity"
  "s_vec" :: "Purely hydrodynamic part of conserved momentum without volume factor"
} "v_vec"

BOOLEAN interpolate_failed_c2p "Interpolate those grid points where c2p failed." STEERABLE=always
{
} no

CCTK_INT local_spatial_order "Order of spatial finite differencing" STEERABLE=always
{
  2 :: "Second order finite difference"
  4 :: "Fourth order finite difference"
} 2

CCTK_INT tmunu_interp_order "Order of interpolation used when constructing tmunu" STEERABLE=always
{
  2 :: "Second order interpolation"
  4 :: "Fourth order interpolation"
} 4

BOOLEAN update_tmunu "Updates tmunu gridfunctions if set to yes" STEERABLE=always
{ 
} yes

BOOLEAN zero_psi "Set Psi, time component of 4-vector potential, to zero initially?" STEERABLE=always
{
} yes

BOOLEAN excise "Avoid C2P and use BH values in masked region" STEERABLE=always
{
} no

BOOLEAN use_mask "Use AsterMasks gridfunctions?" STEERABLE=always
{
} no

BOOLEAN add_dissipation "Add KO dissipation on Avec and Psi gridfunctions?" STEERABLE=always
{
} no

CCTK_REAL eps_diss "KO dissipation strength" STEERABLE=always
{
  0:* :: "Larger than 0 to add dissipation. Might be unstable for values > 1/3"
} 0.1

CCTK_INT timelevels "Number of time levels for the state" STEERABLE=recover
{
  0:4 :: ""
} 1

BOOLEAN c2p_off_floor_strict "Shall we strictly always turn off the C2P for rho < rho_atm?" STEERABLE=always
{
} "yes"

